[{"id": 39924, "title": "ESA\u2019s FLEX mission reveals the secret glow of plants", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Videos/2026/09/ESA_s_FLEX_mission_reveals_the_secret_glow_of_plants", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/videos/2026/09/esa_s_flex_mission_reveals_the_secret_glow_of_plants/27465436-1-eng-GB/ESA_s_FLEX_mission_reveals_the_secret_glow_of_plants_card_full.png", "news_site": "ESA", "summary": "Plants may look still and silent, but every leaf is constantly responding to its environment.", "published_at": "2026-09-14T08:00:00Z", "updated_at": "2026-09-14T08:32:33.058323Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39923, "title": "FLEX and Sentinel-3C ready for liftoff on Vega-C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/FLEX_and_Sentinel-3C_ready_for_liftoff_on_Vega-C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/flex_and_sentinel-3c_ready_for_launch/27459766-1-eng-GB/FLEX_and_Sentinel-3C_ready_for_launch_card_full.jpg", "news_site": "ESA", "summary": "Two Earth observation satellites \u2013 ESA\u2019s Fluorescence Explorer (FLEX) satellite, and the third satellite for the Copernicus Sentinel-3 mission \u2013 are encapsulated inside the nose cone of a Vega-C launcher and are awaiting liftoff at Europe\u2019s Spaceport in French Guiana.", "published_at": "2026-09-14T07:20:00Z", "updated_at": "2026-09-14T08:32:42.613527Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39920, "title": "Vega C set to launch the ESA Sentinel-3C and FLEX missions from Kourou", "authors": [{"name": "Justin Davenport", "socials": null}], "url": "https://www.nasaspaceflight.com/2026/09/vega-c-launch-sentinel-3c-flex/", "image_url": "https://www.nasaspaceflight.com/wp-content/uploads/2026/09/AB9BC3AB-D87F-4E6B-96AE-9902C9A9F085-scaled.jpeg", "news_site": "NASASpaceflight", "summary": "Avio S.p.A., the Italian prime contractor, launch service provider, and launch operator for the Vega\u2026\r\nThe post Vega C set to launch the ESA Sentinel-3C and FLEX missions from Kourou appeared first on NASASpaceFlight.com.", "published_at": "2026-09-13T22:45:53Z", "updated_at": "2026-09-14T08:32:49.081638Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39903, "title": "A team of teams like never before: rehearsing a unique launch at ESA mission control", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Enabling_Support/Operations/A_team_of_teams_like_never_before_rehearsing_a_unique_launch_at_ESA_mission_control", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/teams_at_esoc_during_esa_s_flex_and_copernicus_sentinel-3c_launch_and_early_orbit_leop_simulations/27464737-3-eng-GB/Teams_at_ESOC_during_ESA_s_FLEX_and_Copernicus_Sentinel-3C_launch_and_early_orbit_LEOP_simulations_card_full.png", "news_site": "ESA", "summary": "On 15 September, two spacecraft will leave Earth together aboard the same launcher from Europe\u2019s spaceport in Kourou: FLEX, ESA\u2019s photosynthesis mission, and Sentinel-3C, Copernicus\u2019 newest satellite monitoring Earth\u2019s oceans, land, ice and atmosphere.", "published_at": "2026-09-11T08:00:00Z", "updated_at": "2026-09-13T06:36:05.429995Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39872, "title": "Vega-C flight VV30 with FLEX and Sentinel-3C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/Vega-C_flight_VV30_with_FLEX_and_Sentinel-3C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/vega-c_flight_vv30_with_flex_and_sentinel-3c/27459948-1-eng-GB/Vega-C_flight_VV30_with_FLEX_and_Sentinel-3C_card_full.png", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-09T10:13:00Z", "updated_at": "2026-09-10T11:12:03.919642Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39886, "title": "pVega-C flight VV30 with FLEX and Sentinel-3C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/pVega-C_flight_VV30_with_FLEX_and_Sentinel-3C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/pvega-c_flight_vv30_with_flex_and_sentinel-3c/27459948-1-eng-GB/pVega-C_flight_VV30_with_FLEX_and_Sentinel-3C_card_full.png", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-09T10:13:00Z", "updated_at": "2026-09-10T11:20:25.856519Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39874, "title": "Watch: FLEX and Sentinel-3C launch on Vega-C", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/Watch_FLEX_and_Sentinel-3C_launch_on_Vega-C", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/vega-c_fairing_opens_to_reveal_sentinel-3c_and_flex/27460042-1-eng-GB/Vega-C_fairing_opens_to_reveal_Sentinel-3C_and_FLEX_card_full.jpg", "news_site": "ESA", "summary": "The European Space Agency\u2019s FLEX satellite and the Copernicus Sentinel-3C satellite are scheduled to launch together aboard a Vega-C rocket on 15 September at 03:21 CEST (14 September at 22:21 local time). Watch the VV30 launch live from Europe\u2019s Spaceport in French Guiana, with coverage starting at 02:50 CEST.", "published_at": "2026-09-09T09:56:00Z", "updated_at": "2026-09-10T11:11:44.248653Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39836, "title": "Media briefing ahead of FLEX and Sentinel-3C launch", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Videos/2026/09/Media_briefing_ahead_of_FLEX_and_Sentinel-3C_launch", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/videos/2026/09/media_briefing_ahead_of_flex_and_sentinel-3c_launch/27445744-3-eng-GB/Media_briefing_ahead_of_FLEX_and_Sentinel-3C_launch_card_full.png", "news_site": "ESA", "summary": "On 4 September 2026, media representatives joined an online briefing ahead of the launch of ESA\u2019s FLEX and the Copernicus Sentinel-3C satellites.", "published_at": "2026-09-04T14:00:00Z", "updated_at": "2026-09-04T18:02:15.799380Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39815, "title": "FLEX and Sentinel-3C sealed within Vega-C fairing", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/Applications/Observing_the_Earth/FLEX_and_Sentinel-3C_sealed_within_Vega-C_fairing", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/flex_and_sentinel-3c_being_sealed_from_view/27447417-4-eng-GB/FLEX_and_Sentinel-3C_being_sealed_from_view_card_full.jpg", "news_site": "ESA", "summary": "At Europe\u2019s Spaceport in French Guiana, preparations for one of the year\u2019s most anticipated Earth-observation launches are entering their final stages.", "published_at": "2026-09-02T16:08:00Z", "updated_at": "2026-09-03T13:13:08.909575Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}, {"id": 39870, "title": "Sentinel-3C positioned on the top of the Vespa adapter", "authors": [{"name": "ESA", "socials": null}], "url": "https://www.esa.int/ESA_Multimedia/Images/2026/09/Sentinel-3C_positioned_on_the_top_of_the_Vespa_adapter", "image_url": "https://www.esa.int/var/esa/storage/images/esa_multimedia/images/2026/09/sentinel-3c_positioned_on_the_top_of_the_vespa_adapter/27451566-1-eng-GB/Sentinel-3C_positioned_on_the_top_of_the_Vespa_adapter_card_full.jpg", "news_site": "ESA", "summary": "From the ESA Blogs.", "published_at": "2026-09-02T08:30:00Z", "updated_at": "2026-09-09T09:12:49.513471Z", "featured": false, "launches": [{"launch_id": "8effc13a-c658-4d2e-9f15-8dba4d7fe2dd", "provider": "Launch Library 2"}], "events": []}]